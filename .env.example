# Identifiants publics EmailJS (tableau de bord → Account / Email Services / Templates).
# Ils sont inlinés au build et visibles dans le JS : c'est prévu ainsi. Le plan
# gratuit n'offre pas de liste de domaines autorisés ; la protection repose sur
# reCAPTCHA v2 et sur le quota mensuel.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Clé de site reCAPTCHA v2 (type « Invisible ») dont la clé secrète est
# enregistrée dans les réglages du template EmailJS.
# Sans ces variables, le formulaire reste en repli `mailto:`.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
